{%- liquid
  assign full_width_section = section.settings.full_width_section
  assign banner = section.settings.banner_img
  assign heading_text = section.settings.heading_text
  assign desc_text = section.settings.desc_text
-%}

<div class="hero-banner page-width{% if full_width_section %}page-width--full {% endif %}">
  <div>
    {% if banner != blank %}
      {{ banner | image_url: width: 1000 | image_tag }}
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_img",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "Heading Text"
    },
    {
      "type": "textarea",
      "id": "desc_text",
      "label": "Description Text",
      "default": "Description Text"
    },
    {
      "type": "checkbox",
      "id": "full_width_section",
      "label": "Full Width Section",
      "default": false
    }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
