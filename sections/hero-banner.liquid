{%- liquid

-%}

<div class="hero-banner">
  {{ 'hero-apparel-1' | placeholder_svg_tag }}
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_img",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "Heading Text"
    },
    {
      "type": "textarea",
      "id": "desc_text",
      "label": "Description Text",
      "default": "Description Text"
    },
    {
      "type": "checkbox",
      "id": "full_width_section",
      "label": "Full Width Section",
      "default": false
    }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
